{
    "name": "Dixlase Inquiry",
    "package_name": "dixlase/dixlase-inquiry",
    "slug": "dixlase-inquiry",
    "version": "0.1.0",
    "description": {
        "ja": "お問い合わせフォーム機能を提供するプラグインです。",
        "en": "This plugin provides inquiry form functionality."
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "namespace": "Plugins\\DixlaseInquiry",
    "providers": [
        "Plugins\\DixlaseInquiry\\App\\Providers\\DixlaseInquiryServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "forms",
    "tags": [
        "inquiry",
        "contact",
        "form"
    ],
    "capabilities": [
        "captcha",
        "multilingual-content"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-inquiry:settings",
                "model": "Plugins\\DixlaseInquiry\\App\\Models\\DixlaseInquirySettingsAggregate",
                "label_key": "dixlase-inquiry::multilingual_types.settings",
                "fields": [
                    {"name": "form_heading",       "type": "text",     "rules": "nullable|string|max:100"},
                    {"name": "form_description",   "type": "textarea", "rules": "nullable|string|max:500"},
                    {"name": "completion_title",   "type": "text",     "rules": "nullable|string|max:100"},
                    {"name": "completion_message", "type": "textarea", "rules": "nullable|string|max:1000"},
                    {"name": "auto_reply_subject", "type": "text",     "rules": "nullable|string|max:200"},
                    {"name": "auto_reply_body",    "type": "textarea", "rules": "nullable|string|max:5000"}
                ]
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.0",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": true
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [],
            "core_tables_read": ["site_settings", "captcha_enabled_forms"],
            "core_tables_write": ["members_role_permissions"]
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": true,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": true,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": true,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "en": "Reads site_settings via App\\Facades\\SiteSettings for admin-mode detection and mail-test status. Reads captcha_enabled_forms (no core contract yet) for the dashboard 'captcha not enabled' notification — wrapped in DixlaseInquiryDashboardProvider::isCaptchaEnabledForInquiryForm() so the v0.2 migration to CaptchaServiceInterface is a one-method change. Seeder writes members_role_permissions during install for default inquiry-menu role setup (no core install hook yet); will move to a core install hook in v0.2. See Core repo .claude/plans/handoff-plugin-core-access-cleanup.md.",
            "ja": "site_settings は App\\Facades\\SiteSettings 経由で管理モード判定とメールテスト状態に参照。captcha_enabled_forms はダッシュボードの『CAPTCHA 未設定』通知で参照 (core 契約が未提供のため一時的な直接アクセス) — DixlaseInquiryDashboardProvider::isCaptchaEnabledForInquiryForm() に隔離してあり、v0.2 で CaptchaServiceInterface に置き換える際は 1 メソッドの差し替えで済む。Seeder はインストール時に members_role_permissions へ書き込み問い合わせメニューの既定ロール権限を初期化 (core の install フック未提供)。v0.2 で core install フックに移行予定。Core リポジトリの .claude/plans/handoff-plugin-core-access-cleanup.md を参照。"
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
                "css/style.scss"
            ],
            "admin": [],
            "front": []
        },
        "contracts": [
            "RouteSlugProvider",
            "DashboardNotificationProviderInterface",
            "CaptchaFormProviderInterface"
        ],
        "migrations": true,
        "commands": false,
        "middleware": false
    }
}
