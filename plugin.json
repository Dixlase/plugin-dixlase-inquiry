{
    "name": "Dixlase Inquiry",
    "package_name": "dixlase/dixlase-inquiry",
    "slug": "dixlase-inquiry",
    "version": "0.1.0",
    "description": {
        "ja": "お問い合わせフォーム機能を提供するプラグインです。",
        "en": "This plugin provides inquiry form functionality."
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE-COMMERCIAL",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "namespace": "Plugins\\DixlaseInquiry",
    "providers": [
        "Plugins\\DixlaseInquiry\\App\\Providers\\DixlaseInquiryServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "forms",
    "tags": [
        "inquiry",
        "contact",
        "form"
    ],
    "capabilities": [
        "captcha",
        "multilingual-content"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-inquiry:settings",
                "cardinality": "singleton",
                "provider": "Plugins\\DixlaseInquiry\\App\\Multilingual\\InquirySettingsProvider",
                "label_key": "dixlase-inquiry::multilingual_types.settings",
                "fields": [
                    {
                        "name": "form_heading",
                        "type": "text",
                        "rules": "nullable|string|max:100"
                    },
                    {
                        "name": "form_description",
                        "type": "textarea",
                        "rules": "nullable|string|max:500"
                    },
                    {
                        "name": "completion_title",
                        "type": "text",
                        "rules": "nullable|string|max:100"
                    },
                    {
                        "name": "completion_message",
                        "type": "textarea",
                        "rules": "nullable|string|max:1000"
                    },
                    {
                        "name": "auto_reply_subject",
                        "type": "text",
                        "rules": "nullable|string|max:200"
                    },
                    {
                        "name": "auto_reply_body",
                        "type": "textarea",
                        "rules": "nullable|string|max:5000"
                    }
                ]
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.0",
        "dixlase_api": "^0.1",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": true
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [],
            "core_tables_read": [
                "site_settings",
                "captcha_enabled_forms"
            ],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": true,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": true,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": true,
            "modify_routes": false
        },
        "_optional": [
            "database.core_tables_read"
        ],
        "_notes": {
            "en": "Reads site_settings via App\\Facades\\SiteSettings for admin-mode detection and mail-test status. Reads captcha_enabled_forms (no core contract yet) for the dashboard 'captcha not enabled' notification — wrapped in DixlaseInquiryDashboardProvider::isCaptchaEnabledForInquiryForm() so the v0.2 migration to CaptchaServiceInterface is a one-method change. database.core_tables_read is listed under _optional because the core scanner's DatabaseDetectionPattern regex only recognises a hardcoded shortlist of models (User|Member|Plugin|Media|Setting|SiteSetting|SecuritySetting) and tables (users|members|plugins|media|settings|site_settings|security_settings); facade access (SiteSettings) and CaptchaEnabledForm both fall outside that shortlist and are reported as 'unused declaration' false positives. The declaration is kept because it accurately describes what the plugin touches. See Core repo .claude/plans/handoff-plugin-core-access-cleanup.md.",
            "ja": "site_settings は App\\Facades\\SiteSettings 経由で管理モード判定とメールテスト状態に参照。captcha_enabled_forms はダッシュボードの『CAPTCHA 未設定』通知で参照 (core 契約が未提供のため一時的な直接アクセス) — DixlaseInquiryDashboardProvider::isCaptchaEnabledForInquiryForm() に隔離してあり、v0.2 で CaptchaServiceInterface に置き換える際は 1 メソッドの差し替えで済む。database.core_tables_read を _optional に入れているのは、コアスキャナの DatabaseDetectionPattern 正規表現が固定のモデル短縮リスト (User|Member|Plugin|Media|Setting|SiteSetting|SecuritySetting) とテーブル短縮リスト (users|members|plugins|media|settings|site_settings|security_settings) しか認識せず、ファサード経由 (SiteSettings) と CaptchaEnabledForm がいずれもその短縮リスト外で『未使用宣言』の false positive として誤検出されるため。宣言自体はプラグインが実際に触るものを正確に表しているので残す。Core リポジトリの .claude/plans/handoff-plugin-core-access-cleanup.md を参照。"
        }
    },
    "declares": {
        "configs": {
            "roles": true,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
                "css/style.scss"
            ],
            "admin": [],
            "front": []
        },
        "contracts": [
            "RouteSlugProvider",
            "DashboardNotificationProviderInterface",
            "CaptchaFormProviderInterface"
        ],
        "migrations": true,
        "commands": false,
        "middleware": false
    },
