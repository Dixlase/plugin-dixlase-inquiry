{
    "name": "Dixlase Inquiry",
    "package_name": "dixlase/dixlase-inquiry",
    "slug": "dixlase-inquiry",
    "version": "1.0.0",
    "description": {
        "ja": "お問い合わせフォーム機能を提供するプラグインです。",
        "en": "This plugin provides inquiry form functionality."
    },
    "author": "exc-D inc.",
    "email": "info@exc-d.com",
    "url": "https://exc-d.com",
    "license": "GPL-3.0",
    "license_template": "license-gpl.txt",
    "providers": [
        "Plugins\\DixlaseInquiry\\App\\Providers\\DixlaseInquiryServiceProvider"
    ],
    "namespace": "Plugins\\DixlaseInquiry",
    "type": "dixlase-plugin",
    "category": "forms",
    "tags": [
        "inquiry",
        "contact",
        "form"
    ],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": true
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": []
        },
        "storage": {
            "own_directory": true,
            "public_uploads": false,
            "temp_files": true
        },
        "settings": {
            "read_core": true,
            "write_own": true
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": true,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": true,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        }
    }
}