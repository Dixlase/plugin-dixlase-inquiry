{
    "name": "Dixlase Inquiry",
    "package_name": "dixlase/dixlase-inquiry",
    "slug": "dixlase-inquiry",
    "version": "1.0.0",
    "description": {
        "ja": "お問い合わせフォーム機能を提供するプラグインです。",
        "en": "This plugin provides inquiry form functionality."
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "office@exc-d.com",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "office@exc-d.com"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "namespace": "Plugins\\DixlaseInquiry",
    "providers": [
        "Plugins\\DixlaseInquiry\\App\\Providers\\DixlaseInquiryServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "forms",
    "tags": [
        "inquiry",
        "contact",
        "form"
    ],
    "capabilities": [
        "captcha"
    ],
    "requires": {
        "dixlase": "^0.1.0",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true,
        "shortcodes": true
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": [],
            "core_tables_read": [
                "captcha_enabled_forms"
            ],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": true,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": true,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": true,
            "modify_routes": false
        },
        "_optional": [
            "database.core_tables_read"
        ],
        "_notes": {
            "ja": "database.core_tables_read: captcha_enabled_forms テーブルへの読み取り（CaptchaEnabledForm モデル経由）。スキャナーの検出パターンに captcha_enabled_forms が含まれていないため未検出となる。",
            "en": "database.core_tables_read: Reads from captcha_enabled_forms table via CaptchaEnabledForm model. Not detected by scanner since captcha_enabled_forms is not in the detection patterns."
        }
    },
    "declares": {
        "configs": {
            "roles": false,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
                "css/style.scss"
            ],
            "admin": [],
            "front": []
        },
        "contracts": [
            "RouteSlugProvider",
            "DashboardNotificationProviderInterface",
            "CaptchaFormProviderInterface"
        ],
        "migrations": true,
        "commands": false,
        "middleware": false
    }
}
